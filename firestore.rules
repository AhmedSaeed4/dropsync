rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Trusted-tier helpers ----
    // Owner identity lives in the config/owner doc (uid field), not hardcoded here.
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/owner)
        && get(/databases/$(database)/documents/config/owner).data.uid == request.auth.uid;
    }
    function isTrusted() {
      return isOwner()
        || (request.auth != null
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'trusted');
    }
    // A write is "forever" if it sets the expiration option to 'forever' or has no expiry.
    function isForeverWrite() {
      return request.resource.data.expirationOption == 'forever'
          || request.resource.data.expiresAt == null;
    }

    // ---- Locked-drop helpers (apply to update/delete of an existing drop) ----
    // True if the existing drop is locked (missing field = open, so old drops stay editable).
    function isLockedDrop() {
      return 'locked' in resource.data && resource.data.locked == true;
    }
    // Creator of the existing drop.
    function isDropCreator() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }
    // Owner of the workspace the existing drop lives in (false for personal drops).
    function isDropWorkspaceOwner() {
      return request.auth != null
        && resource.data.workspaceId != null
        && exists(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.ownerId == request.auth.uid;
    }
    // A regular member of the drop's workspace (false for personal drops).
    function isDropWorkspaceMember() {
      return request.auth != null
        && resource.data.workspaceId != null
        && exists(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId))
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.members;
    }
    // Creator or workspace owner — full control of the drop.
    function canMutateDrop() {
      return isDropCreator() || isDropWorkspaceOwner();
    }
    // A drop whose timer has already run out. Forever drops (expiresAt null) are never "expired".
    function isExpiredDrop() {
      return resource.data.expiresAt != null
        && resource.data.expiresAt <= request.time;
    }

    // Users collection - field-guarded: read all users; create your own with tier 'standard';
    // update any of your own fields EXCEPT tier; the owner may update ONLY tier.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (request.resource.data.tier == 'standard' || !('tier' in request.resource.data));
      allow update: if (
        (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tier']))
        ||
        (request.auth != null && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier']))
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Config collection (config/owner holds the owner uid). Readable by any authenticated user
    // (the /admin page reads it client-side); never client-writable — only the console / Admin SDK.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User encryption keys - users can only access their own keys
    match /userKeys/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        request.auth.uid in request.resource.data.members ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        resource.data.ownerId == request.auth.uid
      );

      // Group chat messages - only workspace members can read/write
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members &&
          request.auth.uid == request.resource.data.senderId;
        allow delete: if request.auth != null && (
          (request.auth.uid == resource.data.senderId &&
           request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members)
          ||
          request.auth.uid == get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId
        );
        allow update: if false;
      }

      // Per-user group chat read state - user can only access their own doc, must be a workspace member
      match /readState/{userId} {
        allow read: if request.auth != null &&
          request.auth.uid == userId &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
        allow write: if request.auth != null &&
          request.auth.uid == userId &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
      }
    }

    // Workspace encryption keys - only workspace members can access
    match /workspaceKeys/{workspaceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Drops collection
    match /drops/{dropId} {
      // Create - must be authenticated, own the drop, and be trusted to make it last forever
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && (!isForeverWrite() || isTrusted());

      // Read - authenticated users can read their own drops or workspace drops they're a member of
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        (resource.data.workspaceId != null &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.members)
      );

      // Update - creator/owner always; a member only if the drop is NOT locked; forever writes still
      // require a trusted tier; only creator/owner may touch the locked field.
      allow update: if request.auth != null
        && (canMutateDrop() || (!isLockedDrop() && isDropWorkspaceMember()))
        && (!isForeverWrite() || isTrusted())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['locked']) || canMutateDrop());

      // Delete - creator/owner always; a member may delete an open drop OR an already-expired drop
      // (so cleanup can remove dead locked drops when only members are online). Live locked + forever
      // drops stay protected.
      allow delete: if request.auth != null && (
        canMutateDrop()
        || (isDropWorkspaceMember() && (!isLockedDrop() || isExpiredDrop()))
      );
    }

    // Categories collection - users can only access their own personal categories or workspace categories
    match /categories/{categoryId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        resource.data.workspaceId != null
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Chat conversations - users can only access their own
    match /chats/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /conversations/{convId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;

        match /messages/{msgId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}