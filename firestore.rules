rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Trusted-tier helpers ----
    // Owner identity lives in the config/owner doc (uid field), not hardcoded here.
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/owner)
        && get(/databases/$(database)/documents/config/owner).data.uid == request.auth.uid;
    }
    function isTrusted() {
      return isOwner()
        || (request.auth != null
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'trusted');
    }
    // A write is "forever" if it sets the expiration option to 'forever' or has no expiry.
    function isForeverWrite() {
      return request.resource.data.expirationOption == 'forever'
          || request.resource.data.expiresAt == null;
    }

    // ---- Locked-drop helpers (apply to update/delete of an existing drop) ----
    // True if the existing drop is locked (missing field = open, so old drops stay editable).
    function isLockedDrop() {
      return 'locked' in resource.data && resource.data.locked == true;
    }
    // Creator of the existing drop.
    function isDropCreator() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }
    // Owner of the workspace the existing drop lives in (false for personal drops).
    function isDropWorkspaceOwner() {
      return request.auth != null
        && resource.data.workspaceId != null
        && exists(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.ownerId == request.auth.uid;
    }
    // A regular member of the drop's workspace (false for personal drops).
    function isDropWorkspaceMember() {
      return request.auth != null
        && resource.data.workspaceId != null
        && exists(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId))
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.members;
    }
    // Creator or workspace owner — full control of the drop.
    function canMutateDrop() {
      return isDropCreator() || isDropWorkspaceOwner();
    }
    // A drop whose timer has already run out. Forever drops (expiresAt null) are never "expired".
    function isExpiredDrop() {
      return resource.data.expiresAt != null
        && resource.data.expiresAt <= request.time;
    }

    // Users collection - field-guarded + SELF/OWNER-ONLY read (closes the "any authed user reads
    // any user's email + tier" leak — audit critical #5). Display fields (displayName, photoURL)
    // moved to the world-readable profiles collection below; email + tier stay here. isTrusted()
    // keeps reading SELF tier via the server-side get() in the helper above (bypasses this client
    // read rule), so the trusted/forever-drop feature is unaffected. Create your own with tier
    // 'standard'; update any of your own fields EXCEPT tier; the owner may update ONLY tier.
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isOwner());
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (request.resource.data.tier == 'standard' || !('tier' in request.resource.data));
      allow update: if (
        (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tier']))
        ||
        (request.auth != null && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier']))
      );
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Per-device FCM push tokens (push foundation). The doc id is the token string. A user may
      // create/delete only their own token docs; reads are closed (the server reads tokens via the
      // Admin SDK in a later stage, which bypasses these rules). No updates allowed.
      match /fcmTokens/{token} {
        allow read: if false;
        allow create: if request.auth != null && request.auth.uid == userId
                        && request.resource.data.uid == userId
                        && request.resource.data.token == token;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      // @mention inbox — per-user PLAINTEXT pointer docs (workspaceId/workspaceName/messageId/
      // senderId/senderName) written ONLY by the /api/notify-mention route via the Admin SDK
      // (write:false here; the client readState rule is self-only so cross-user mention delivery
      // must run server-side). Clients may read + delete their OWN: read drives the switcher glow +
      // foreground system notification; delete clears the glow on read. Self-only — no field rules
      // needed (these docs carry no secrets; the message body stays encrypted in the messages doc).
      match /mentions/{mentionId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // User PROFILES — world-readable display fields (displayName, photoURL). Any logged-in user
    // needs another user's display name to render workspace member lists + the account-deletion
    // peer picker. Only the owner may create/update/delete their own. Sensitive fields (email,
    // tier) stay in users/{uid} above, which is now self/owner-only-read. Mirrors the
    // userPublicKeys pattern. SIGNUPS WRITE THIS DOC ATOMICALLY WITH users/{uid} via writeBatch —
    // it MUST exist before any signup batch commits, hence it ships in this same PR.
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Config collection (config/owner holds the owner uid). config/owner is readable by the OWNER
    // only (closes owner de-anonymization); other config docs stay readable by any authenticated
    // user. Never client-writable — only the console / Admin SDK. NOTE: the isOwner()/isTrusted()
    // helpers read config/owner SERVER-SIDE via get(), which is NOT gated by this client read rule,
    // so those (and the drops create forever/trusted check) keep working unchanged.
    match /config/{docId} {
      allow read: if request.auth != null && (isOwner() || docId != 'owner');
      allow write: if false;
    }

    // User encryption keys - SELF-ONLY read (closes the "any authed user reads any user's
    // masterKey/encryptedPrivateKey/iv/publicKey" leak — audit critical #4). Other users read
    // publicKey from the separate world-readable userPublicKeys collection below. create/update/
    // delete were already self-only.
    match /userKeys/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // User PUBLIC keys — world-readable. Any logged-in user needs another user's ECDH
    // publicKey to encrypt/view personal drops. Only the owner may write/delete their own.
    // (publicKey is also still stored in userKeys, but that doc is now self-only-read, so it is
    // unreachable to other users — they fetch the key from here instead.)
    match /userPublicKeys/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.members
          || resource.data.ownerId == request.auth.uid);
      // Owner = full control (owner branch below). Join now goes through the server route
      // /api/workspaces/join (Admin SDK, bypasses these rules), which verifies the invite code
      // server-side — client self-add is intentionally removed. The read above is locked to
      // member/owner so the invite code can't be enumerated (the route does the lookup server-side).
      // The only remaining client-side members mutation is self-remove (leave): new ⊆ old AND
      // |new|==|old|-1 AND caller∈old AND caller∉new — no other uid can be kicked/smuggled.
      // ownerId/name/inviteCode are immutable for non-owners; accountDeletion's owner-transfer is
      // covered by the owner branch, its member-leave by the self-remove below.
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.ownerId == resource.data.ownerId
          && (
            // self-remove (leave): new ⊆ old, exactly one uid (the caller) dropped
            (request.auth.uid in resource.data.members
              && !(request.auth.uid in request.resource.data.members)
              && request.resource.data.members.hasOnly(resource.data.members)
              && request.resource.data.members.size() == resource.data.members.size() - 1)
          )
        )
      );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Group chat messages - only workspace members can read/write
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members &&
          request.auth.uid == request.resource.data.senderId
          // Trust anchors the update rule relies on — enforced at create so a raw-SDK member can't
          // forge a malformed message that defeats the 24h window (future-dated createdAt), the
          // 10-edit cap (editCount < 0), or inject plaintext (encrypted:false). A serverTimestamp()
          // write resolves to request.time, so legitimate sends (sendGroupMessage) still pass.
          && request.resource.data.encrypted == true
          && request.resource.data.editCount == 0
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && (
          (request.auth.uid == resource.data.senderId &&
           request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members)
          ||
          request.auth.uid == get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId
        );
        // Edit your OWN message only — sender-only (NOT the owner), within 24h, capped at 10 edits.
        allow update: if request.auth != null
          // caller IS the EXISTING doc's sender (resource.data = pre-update; senderId cannot be reassigned via payload)
          && 'senderId' in resource.data
          && request.auth.uid == resource.data.senderId
          // still a current member (revoked members lose edit access)
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members
          // allowlist of mutable keys: senderId/senderName/createdAt/encrypted are NOT here -> immutable.
          // (also blocks a full set()-replacement, which diffs every key -> hasOnly fails)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'iv', 'edited', 'editedAt', 'editCount'])
          // encryption flag stays true in the result (blocks plaintext-injection via encrypted=false)
          && 'encrypted' in request.resource.data
          && request.resource.data.encrypted == true
          // edited flag MUST be true in the result (blocks a stealth edit that changes content/iv but
          // hides the "(edited)" indicator — locked decision #2; mirrors the encrypted enforcement)
          && 'edited' in request.resource.data
          && request.resource.data.edited == true
          // 24h window in TRUSTED server time vs immutable createdAt (24h = 86,400,000 ms). A message
          // with null/missing createdAt is DENIED (not allowed) — otherwise a raw-SDK attacker could
          // create a null-createdAt message and edit it past the 24h lock.
          && 'createdAt' in resource.data
          && resource.data.createdAt != null
          && request.time.toMillis() - resource.data.createdAt.toMillis() <= 86400000
          // ~10-edit cap: editCount must increment by exactly 1 and prior count < 10
          && (('editCount' in resource.data)
              ? (request.resource.data.editCount == resource.data.editCount + 1
                 && resource.data.editCount < 10)
              : request.resource.data.editCount == 1);
      }

      // Per-user group chat read state - user can only access their own doc, must be a workspace member
      match /readState/{userId} {
        allow read: if request.auth != null &&
          request.auth.uid == userId &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
        allow write: if request.auth != null &&
          request.auth.uid == userId &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
      }

      // Group chat typing indicator — per-user ephemeral plaintext doc. Read open to ALL workspace
      // members (so everyone sees who is typing); write restricted to the doc owner (self only) so
      // no one can spoof another user as typing. These rules do NO field-equality check, so the
      // missing-field gotcha does not apply.
      match /typing/{userId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
        allow write: if request.auth != null &&
          request.auth.uid == userId &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
      }

      // Group chat online presence — per-user ephemeral plaintext doc. Same shape: member-wide
      // read (so everyone sees who is online / last-seen), self-only write (anti-spoof).
      match /presence/{userId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
        allow write: if request.auth != null &&
          request.auth.uid == userId &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
      }
    }

    // Workspace encryption keys. Read -> workspace MEMBER only (members decrypt drops + group chat
    // with the key via getWorkspaceKey). Create/update -> workspace OWNER only (the key is written
    // once by the workspace creator at creation time; no legitimate flow ever rewrites it). Stops any
    // authenticated user bricking a key (a permanent "[Decryption failed]" DoS for the whole
    // workspace) or reading keySecret for a workspace they are not a member of.
    match /workspaceKeys/{workspaceId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    // Drops collection
    match /drops/{dropId} {
      // Create - must be authenticated, own the drop, be trusted to make it last forever, AND be a
      // member of the target workspace. Personal drops (workspaceId == null) are unaffected. Call
      // drops are created ONLY by /api/call/start (Admin SDK, bypasses rules) — block any client
      // create of type 'call' so a raw-SDK member can't mint a rogue call drop that escapes the
      // one-call-per-workspace + capacity-4 invariants the route enforces (§3: "NEVER client-side").
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && (!isForeverWrite() || isTrusted())
        && (request.resource.data.workspaceId == null
            || request.auth.uid in get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.members)
        && request.resource.data.type != 'call';

      // Read - authenticated users can read their own drops or workspace drops they're a member of
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        (resource.data.workspaceId != null &&
          request.auth.uid in get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.members)
      );

      // Update - creator/owner always; a member only if the drop is NOT locked; forever writes still
      // require a trusted tier; only creator/owner may touch the locked field. Call drops are NEVER
      // client-updatable — liveness lives in callPresence/{uid}.lastSeen and the roster/callState
      // are route-only (the Admin route bypasses rules). Block ALL client updates to a call drop.
      allow update: if request.auth != null
        && (canMutateDrop() || (!isLockedDrop() && isDropWorkspaceMember()))
        && (!isForeverWrite() || isTrusted())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['locked']) || canMutateDrop())
        && !(resource.data.type == 'call');

      // Delete - creator/owner always; a member may delete an open drop OR an already-expired drop
      // (so cleanup can remove dead locked drops when only members are online). Live locked + forever
      // drops stay protected. A LIVE call drop is NEVER client-deletable — the leave route owns
      // deletion (last-leave cascade). The ONE exception: an EXPIRED call (the 4h static backstop
      // has passed) MAY be client-deleted so cleanupExpiredDrops can reap a total-zombie call where
      // everyone crashed (§5). (Without this, the §4 client-delete block + §5's "no sweeper edit"
      // would leave zombie calls undeletable forever.) Subcollection orphans from this rare path are
      // Admin-only to cascade (noted in the report).
      allow delete: if request.auth != null && (
        canMutateDrop()
        || (isDropWorkspaceMember() && (!isLockedDrop() || isExpiredDrop()))
      ) && (resource.data.type != 'call' || isExpiredDrop());

      // ---- Live-call signaling (per peer pair) ---- SDP offer/answer + coalesced ICE candidates
      // for one pair in a call drop's full mesh. Both ends are authenticated members of the call's
      // workspace AND listed in the call's roster (callParticipantUids). WebRTC-correct (an offer is
      // FROM one peer TO another) AND quota-minimal (≤6 pair docs for a 4-person mesh; ICE coalesces
      // via arrayUnion into two arrays, never one addDoc per candidate). The Admin leave route
      // cascades these (bypasses rules); clients never delete. Field allowlist on UPDATE keeps a
      // member from writing anything beyond the signaling keys.
      match /callSignals/{pairId} {
        function isCallMember() {
          return request.auth != null
            && exists(/databases/$(database)/documents/drops/$(dropId))
            && get(/databases/$(database)/documents/drops/$(dropId)).data.type == 'call'
            && request.auth.uid in get(/databases/$(database)/documents/drops/$(dropId)).data.callParticipantUids;
        }
        allow read, create: if isCallMember();
        allow update: if isCallMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offerA', 'offerB', 'answerA', 'answerB', 'candidatesFromA', 'candidatesFromB', 'politeRole', 'updatedAt']);
        allow delete: if false;
      }

      // ---- Live-call presence (per-participant heartbeat) ---- lastSeen is a serverTimestamp
      // SENTINEL (never a client Date — dodges the cross-device clock-skew bug already fixed for
      // workspace presence/typing/seen-by). Each participant writes ONLY their own doc (self-only)
      // and ONLY the lastSeen field. reap-stale/leave routes delete these (bypass rules).
      match /callPresence/{uid} {
        function isCallPresenceMember() {
          return request.auth != null
            && exists(/databases/$(database)/documents/drops/$(dropId))
            && get(/databases/$(database)/documents/drops/$(dropId)).data.type == 'call'
            && request.auth.uid in get(/databases/$(database)/documents/drops/$(dropId)).data.callParticipantUids;
        }
        allow read: if isCallPresenceMember();
        allow create: if isCallPresenceMember() && request.auth.uid == uid;
        allow update: if isCallPresenceMember()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']);
        allow delete: if false;
      }
    }

    // Categories collection. Read/create -> the creator OR, for workspace categories, a member of
    // that workspace. Delete -> the creator OR the workspace owner (so an injected category can be
    // cleaned up). Closes non-member reads/creates of a workspace's category list and indestructible
    // injected categories. Personal categories (workspaceId == null) stay creator-only.
    match /categories/{categoryId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.createdBy
        || (resource.data.workspaceId != null
            && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.members)
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && (request.resource.data.workspaceId == null
            || request.auth.uid in get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.members);
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.createdBy
        || (resource.data.workspaceId != null
            && get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.ownerId == request.auth.uid)
      );
    }

    // Chat conversations - users can only access their own
    match /chats/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /conversations/{convId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;

        match /messages/{msgId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Agent usage counters (per-user quota) — written ONLY by the backend Admin SDK,
    // keyed on the Firebase-verified uid (the Admin SDK bypasses firestore.rules). Clients
    // never read or write this doc; deny all as defense-in-depth.
    match /usage/{uid} {
      allow read, write: if false;
    }
  }
}