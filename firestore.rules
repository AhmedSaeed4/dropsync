rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Trusted-tier helpers ----
    // Owner identity lives in the config/owner doc (uid field), not hardcoded here.
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/owner)
        && get(/databases/$(database)/documents/config/owner).data.uid == request.auth.uid;
    }
    function isTrusted() {
      return isOwner()
        || (request.auth != null
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'trusted');
    }
    // A write is "forever" if it sets the expiration option to 'forever' or has no expiry.
    function isForeverWrite() {
      return request.resource.data.expirationOption == 'forever'
          || request.resource.data.expiresAt == null;
    }

    // ---- Locked-drop helpers (apply to update/delete of an existing drop) ----
    // True if the existing drop is locked (missing field = open, so old drops stay editable).
    function isLockedDrop() {
      return 'locked' in resource.data && resource.data.locked == true;
    }
    // Creator of the existing drop.
    function isDropCreator() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }
    // Owner of the workspace the existing drop lives in (false for personal drops).
    function isDropWorkspaceOwner() {
      return request.auth != null
        && resource.data.workspaceId != null
        && exists(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.ownerId == request.auth.uid;
    }
    // A regular member of the drop's workspace (false for personal drops).
    function isDropWorkspaceMember() {
      return request.auth != null
        && resource.data.workspaceId != null
        && exists(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId))
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.members;
    }
    // Creator or workspace owner — full control of the drop.
    function canMutateDrop() {
      return isDropCreator() || isDropWorkspaceOwner();
    }
    // A drop whose timer has already run out. Forever drops (expiresAt null) are never "expired".
    function isExpiredDrop() {
      return resource.data.expiresAt != null
        && resource.data.expiresAt <= request.time;
    }

    // ---- Background-deletion helpers (Round 12) ----
    // The frozen deletion job fields live on workspaces/{id} and are minted ONLY by the
    // Admin route /api/workspaces/delete-begin (the Admin SDK bypasses these rules):
    //   deleting, deletingStartedAt, deletingOwner, deletingOwnerName,
    //   deletingRecipients, deleteDone, deleteTotal.
    // True when the named workspace is mid-deletion. A MISSING workspace is never
    // "deleting" — creator-authored leftover drops keep their legacy behavior by design.
    function wsDeleting(workspaceId) {
      return workspaceId != null
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && 'deleting' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.deleting == true;
    }
    // The caller is the frozen deleting owner of the named workspace (the deletion
    // runner's read/delete authority while the lockout holds).
    function isDeletingOwner(workspaceId) {
      return request.auth != null
        && wsDeleting(workspaceId)
        && 'deletingOwner' in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.deletingOwner == request.auth.uid;
    }
    // Account-barrier admission: a MISSING barrier doc is OPEN (normal users); a barrier
    // in active/completing/finalizing BLOCKS. 'cancelled' does not block (the owner
    // aborted and recovered). Rules are fail-closed predicates only — reconciliation
    // never runs here.
    function barrierBlocks(uid) {
      return exists(/databases/$(database)/documents/accountBarriers/$(uid))
        && get(/databases/$(database)/documents/accountBarriers/$(uid)).data.state in ['active', 'completing', 'finalizing'];
    }
    // Import producer epoch (part J / F3): a create that names an importJobId is
    // admitted ONLY while the caller's own matching import fence is OPEN. The field
    // is DISTINCT from the frozen deletion job fields — create-shape validation
    // rejects deletion job fields, while importJobId is admitted only under an OPEN
    // fence. Cancellation closes the fence, so a persistent multi-tab client
    // replaying a buffered write after cancellation is denied at the boundary.
    function importEpochAdmitted() {
      return !('importJobId' in request.resource.data)
        || (request.auth != null
            && exists(/databases/$(database)/documents/importFences/$(request.auth.uid + '_' + request.resource.data.importJobId))
            && get(/databases/$(database)/documents/importFences/$(request.auth.uid + '_' + request.resource.data.importJobId)).data.userId == request.auth.uid
            && get(/databases/$(database)/documents/importFences/$(request.auth.uid + '_' + request.resource.data.importJobId)).data.state == 'open');
    }

    // Users collection - field-guarded + SELF/OWNER-ONLY read (closes the "any authed user reads
    // any user's email + tier" leak — audit critical #5). Display fields (displayName, photoURL)
    // moved to the world-readable profiles collection below; email + tier stay here. isTrusted()
    // keeps reading SELF tier via the server-side get() in the helper above (bypasses this client
    // read rule), so the trusted/forever-drop feature is unaffected. Create your own with tier
    // 'standard'; update any of your own fields EXCEPT tier; the owner may update ONLY tier.
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isOwner());
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (request.resource.data.tier == 'standard' || !('tier' in request.resource.data));
      allow update: if (
        (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tier']))
        ||
        (request.auth != null && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier']))
      );
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Per-device FCM push tokens (push foundation). The doc id is the token string. A user may
      // create/delete only their own token docs; reads are closed (the server reads tokens via the
      // Admin SDK in a later stage, which bypasses these rules). No updates allowed.
      match /fcmTokens/{token} {
        allow read: if false;
        allow create: if request.auth != null && request.auth.uid == userId
                        && request.resource.data.uid == userId
                        && request.resource.data.token == token;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      // @mention inbox — per-user PLAINTEXT pointer docs (workspaceId/workspaceName/messageId/
      // senderId/senderName) written ONLY by the /api/notify-mention route via the Admin SDK
      // (write:false here; the client readState rule is self-only so cross-user mention delivery
      // must run server-side). Clients may read + delete their OWN: read drives the switcher glow +
      // foreground system notification; delete clears the glow on read. Self-only — no field rules
      // needed (these docs carry no secrets; the message body stays encrypted in the messages doc).
      match /mentions/{mentionId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // User PROFILES — world-readable display fields (displayName, photoURL). Any logged-in user
    // needs another user's display name to render workspace member lists + the account-deletion
    // peer picker. Only the owner may create/update/delete their own. Sensitive fields (email,
    // tier) stay in users/{uid} above, which is now self/owner-only-read. Mirrors the
    // userPublicKeys pattern. SIGNUPS WRITE THIS DOC ATOMICALLY WITH users/{uid} via writeBatch —
    // it MUST exist before any signup batch commits, hence it ships in this same PR.
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Config collection (config/owner holds the owner uid). config/owner is readable by the OWNER
    // only (closes owner de-anonymization); other config docs stay readable by any authenticated
    // user. Never client-writable — only the console / Admin SDK. NOTE: the isOwner()/isTrusted()
    // helpers read config/owner SERVER-SIDE via get(), which is NOT gated by this client read rule,
    // so those (and the drops create forever/trusted check) keep working unchanged.
    match /config/{docId} {
      allow read: if request.auth != null && (isOwner() || docId != 'owner');
      allow write: if false;
    }

    // User encryption keys - SELF-ONLY read (closes the "any authed user reads any user's
    // masterKey/encryptedPrivateKey/iv/publicKey" leak — audit critical #4). Other users read
    // publicKey from the separate world-readable userPublicKeys collection below. create/update/
    // delete were already self-only.
    match /userKeys/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // User PUBLIC keys — world-readable. Any logged-in user needs another user's ECDH
    // publicKey to encrypt/view personal drops. Only the owner may write/delete their own.
    // (publicKey is also still stored in userKeys, but that doc is now self-only-read, so it is
    // unreachable to other users — they fetch the key from here instead.)
    match /userPublicKeys/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      // CREATE (Round 12 part B):
      //  * SHAPE — only the known base fields (+ importJobId for a fence-backed import
      //    create). The frozen deletion job fields are NOT in this list, so no client can
      //    ever MINT a deletion job — only the Admin START route does (bypasses rules).
      //  * ADMISSION — the CALLER's account barrier must be open, and so must the PROPOSED
      //    owner's (a raw client cannot create a workspace owned by a deleting account;
      //    normal self-owner constructors are unaffected because their own barrier is
      //    missing/open).
      //  * IMPORT EPOCH — a job-naming create is admitted only under the caller's OPEN
      //    matching import fence.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'members', 'inviteCode', 'createdAt', 'importJobId'])
        && !barrierBlocks(request.auth.uid)
        && !barrierBlocks(request.resource.data.ownerId)
        && importEpochAdmitted();
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.members
          || resource.data.ownerId == request.auth.uid);
      // Owner = full control (owner branch below). Join now goes through the server route
      // /api/workspaces/join (Admin SDK, bypasses these rules), which verifies the invite code
      // server-side — client self-add is intentionally removed. The read above is locked to
      // member/owner so the invite code can't be enumerated (the route does the lookup server-side).
      // The only remaining client-side members mutation is self-remove (leave): new ⊆ old AND
      // |new|==|old|-1 AND caller∈old AND caller∉new — no other uid can be kicked/smuggled.
      //
      // ROUND 12 (part B) — state-entry invariants layered on the same branches:
      //  * ACTIVE workspace: the owner may still change any BASE field (kick rotates members +
      //    inviteCode; transfer changes ownerId), but can never MINT job fields, and an
      //    ownership transfer additionally requires the SUCCESSOR's barrier to be open
      //    (outgoing transfer under the caller's own barrier stays legal — part K).
      //  * DELETING workspace: the job identity is FROZEN. The owner's only writable key is
      //    deleteDone, only monotonically (the deletion runner's progress transaction);
      //    deleteTotal is server-written; kick/transfer/name changes are denied. The deletion
      //    ends with the Admin SEAL route deleting the whole doc.
      //  * SELF-REMOVE (leave) keeps the pre-Round-12 wording — members-only diff — so the
      //    frozen job fields ride along UNCHANGED. Leaving a deleting workspace is legal.
      allow update: if request.auth != null && (
        (
          resource.data.ownerId == request.auth.uid
          && (
            (
              (!('deleting' in resource.data) || resource.data.deleting != true)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'ownerId', 'members', 'inviteCode', 'createdAt'])
              && (request.resource.data.ownerId == resource.data.ownerId
                  || !barrierBlocks(request.resource.data.ownerId))
            )
            ||
            (
              resource.data.deleting == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleteDone'])
              && 'deleteDone' in request.resource.data
              && (
                   ('deleteDone' in resource.data
                     ? request.resource.data.deleteDone >= resource.data.deleteDone
                     : (request.resource.data.deleteDone is number
                        && request.resource.data.deleteDone >= 0))
                 )
            )
          )
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.ownerId == resource.data.ownerId
          && request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.hasOnly(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
        )
      );
      // Raw owner parent-delete retained (the accepted residual: rules cannot prove cleanup).
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Group chat messages - workspace members read/write; Round 12 adds the DELETING-OWNER
      // read + delete (the message-wipe stage runs client-side as the frozen deleting owner)
      // and gates every ordinary member/sender path while the workspace deletes.
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          (!wsDeleting(workspaceId)
            && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members)
          || isDeletingOwner(workspaceId)
        );
        allow create: if request.auth != null
          && !wsDeleting(workspaceId)
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members
          && request.auth.uid == request.resource.data.senderId
          // Trust anchors the update rule relies on — enforced at create so a raw-SDK member can't
          // forge a malformed message that defeats the 24h window (future-dated createdAt), the
          // 10-edit cap (editCount < 0), or inject plaintext (encrypted:false). A serverTimestamp()
          // write resolves to request.time, so legitimate sends (sendGroupMessage) still pass.
          && request.resource.data.encrypted == true
          && request.resource.data.editCount == 0
          && request.resource.data.createdAt == request.time;
        allow delete: if request.auth != null && (
          isDeletingOwner(workspaceId)
          ||
          (request.auth.uid == resource.data.senderId
           && !wsDeleting(workspaceId)
           && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members)
          ||
          request.auth.uid == get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId
        );
        // Edit your OWN message only — sender-only (NOT the owner), within 24h, capped at 10 edits.
        // Round 12: no message edits while the workspace deletes.
        allow update: if request.auth != null
          && !wsDeleting(workspaceId)
          // caller IS the EXISTING doc's sender (resource.data = pre-update; senderId cannot be reassigned via payload)
          && 'senderId' in resource.data
          && request.auth.uid == resource.data.senderId
          // still a current member (revoked members lose edit access)
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members
          // allowlist of mutable keys: senderId/senderName/createdAt/encrypted are NOT here -> immutable.
          // (also blocks a full set()-replacement, which diffs every key -> hasOnly fails)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'iv', 'edited', 'editedAt', 'editCount'])
          // encryption flag stays true in the result (blocks plaintext-injection via encrypted=false)
          && 'encrypted' in request.resource.data
          && request.resource.data.encrypted == true
          // edited flag MUST be true in the result (blocks a stealth edit that changes content/iv but
          // hides the "(edited)" indicator — locked decision #2; mirrors the encrypted enforcement)
          && 'edited' in request.resource.data
          && request.resource.data.edited == true
          // 24h window in TRUSTED server time vs immutable createdAt (24h = 86,400,000 ms). A message
          // with null/missing createdAt is DENIED (not allowed) — otherwise a raw-SDK attacker could
          // create a null-createdAt message and edit it past the 24h lock.
          && 'createdAt' in resource.data
          && resource.data.createdAt != null
          && request.time.toMillis() - resource.data.createdAt.toMillis() <= 86400000
          // ~10-edit cap: editCount must increment by exactly 1 and prior count < 10
          && (('editCount' in resource.data)
              ? (request.resource.data.editCount == resource.data.editCount + 1
                 && resource.data.editCount < 10)
              : request.resource.data.editCount == 1);
      }

      // Per-user group chat read state - user can only access their own doc, must be a workspace
      // member. Round 12: gated off entirely while the workspace deletes (residual orphan docs
      // are accepted — the SEAL cascade removes them server-side).
      match /readState/{userId} {
        allow read: if request.auth != null
          && !wsDeleting(workspaceId)
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
        allow write: if request.auth != null
          && !wsDeleting(workspaceId)
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
      }

      // Group chat typing indicator — per-user ephemeral plaintext doc. Round 12: gated off
      // while the workspace deletes (residual orphans accepted).
      match /typing/{userId} {
        allow read: if request.auth != null
          && !wsDeleting(workspaceId)
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
        allow write: if request.auth != null
          && !wsDeleting(workspaceId)
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
      }

      // Group chat online presence — per-user ephemeral plaintext doc. Round 12: gated off
      // while the workspace deletes (residual orphans accepted).
      match /presence/{userId} {
        allow read: if request.auth != null
          && !wsDeleting(workspaceId)
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
        allow write: if request.auth != null
          && !wsDeleting(workspaceId)
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members;
      }
    }

    // Workspace encryption keys. Read -> workspace MEMBER (Round 12: OR the frozen deleting
    // owner — the runner reads the key state during the key stage). Create/update -> workspace
    // OWNER only, and NEVER while the workspace deletes (no key resurrection); an import-backed
    // key create additionally requires the caller's OPEN matching import fence (the epoch gate).
    match /workspaceKeys/{workspaceId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && (request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members
            || isDeletingOwner(workspaceId));
      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId))
        && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
        && !wsDeleting(workspaceId)
        && importEpochAdmitted();
    }

    // Drops collection
    match /drops/{dropId} {
      // Create - must be authenticated, own the drop, be trusted to make it last forever, AND be a
      // member of the target workspace. Personal drops (workspaceId == null) are unaffected. Call
      // drops are created ONLY by /api/call/start (Admin SDK, bypasses rules). ROUND 12: no new
      // drops into a DELETING destination (checked on the payload's destination at the commit
      // boundary), and a job-naming import create requires the OPEN fence.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && (!isForeverWrite() || isTrusted())
        && (request.resource.data.workspaceId == null
            || (!wsDeleting(request.resource.data.workspaceId)
                && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.members))
        && request.resource.data.type != 'call'
        && importEpochAdmitted();

      // Read - authenticated users can read their own drops or workspace drops they're a member of.
      // ROUND 12: creator/member reads are gated off while the drop's workspace deletes; the
      // frozen deleting owner may enumerate (the loop must see its work queue).
      allow read: if request.auth != null && (
        (!wsDeleting(resource.data.workspaceId)
          && request.auth.uid == resource.data.userId)
        || (resource.data.workspaceId != null
          && !wsDeleting(resource.data.workspaceId)
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.members)
        || isDeletingOwner(resource.data.workspaceId)
      );

      // Update - creator/owner always; a member only if the drop is NOT locked; forever writes still
      // require a trusted tier; only creator/owner may touch the locked field. Call drops are NEVER
      // client-updatable. ROUND 12: no client updates at all while the source workspace deletes, and
      // a workspaceId change is denied if the DESTINATION is deleting (checked on the post-state).
      allow update: if request.auth != null
        && !wsDeleting(resource.data.workspaceId)
        && (canMutateDrop() || (!isLockedDrop() && isDropWorkspaceMember()))
        && (!isForeverWrite() || isTrusted())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['locked']) || canMutateDrop())
        && !(resource.data.type == 'call')
        && (request.resource.data.workspaceId == null
            || request.resource.data.workspaceId == resource.data.workspaceId
            || !wsDeleting(request.resource.data.workspaceId));

      // Delete - creator/owner always; a member may delete an open drop OR an already-expired drop.
      // Client call-drop deletion stays unconditionally forbidden (the terminal route owns call
      // teardown). ROUND 12: creator/member deletes are gated off while the workspace deletes; the
      // frozen deleting owner may delete any non-call drop (the drops stage).
      allow delete: if request.auth != null
        && resource.data.type != 'call'
        && (
          isDeletingOwner(resource.data.workspaceId)
          || (!wsDeleting(resource.data.workspaceId)
              && (canMutateDrop()
                  || (isDropWorkspaceMember() && (!isLockedDrop() || isExpiredDrop()))))
        );

      // ---- Live-call signaling (per peer pair) ---- SDP offer/answer + coalesced ICE candidates
      // for one pair in a call drop's full mesh. ROUND 12: the whole signaling surface is gated off
      // while the call's workspace deletes (the deletion force-ends the call via the terminal
      // route; signaling for a dying call is pointless and members are locked out).
      match /callSignals/{pairId} {
        function isCallMember() {
          return request.auth != null
            && exists(/databases/$(database)/documents/drops/$(dropId))
            && get(/databases/$(database)/documents/drops/$(dropId)).data.type == 'call'
            && get(/databases/$(database)/documents/drops/$(dropId)).data.workspaceId != null
            && !wsDeleting(get(/databases/$(database)/documents/drops/$(dropId)).data.workspaceId)
            && exists(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/drops/$(dropId)).data.workspaceId))
            && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/drops/$(dropId)).data.workspaceId)).data.members
            && request.auth.uid in get(/databases/$(database)/documents/drops/$(dropId)).data.callParticipantUids;
        }
        allow read, create: if isCallMember();
        allow update: if isCallMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offerA', 'offerB', 'answerA', 'answerB', 'candidatesFromA', 'candidatesFromB', 'politeRole', 'updatedAt']);
        allow delete: if false;
      }

      // ---- Live-call presence (per-participant heartbeat) ---- same Round 12 workspace gate.
      match /callPresence/{uid} {
        function isCallPresenceMember() {
          return request.auth != null
            && exists(/databases/$(database)/documents/drops/$(dropId))
            && get(/databases/$(database)/documents/drops/$(dropId)).data.type == 'call'
            && get(/databases/$(database)/documents/drops/$(dropId)).data.workspaceId != null
            && !wsDeleting(get(/databases/$(database)/documents/drops/$(dropId)).data.workspaceId)
            && exists(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/drops/$(dropId)).data.workspaceId))
            && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(get(/databases/$(database)/documents/drops/$(dropId)).data.workspaceId)).data.members
            && request.auth.uid in get(/databases/$(database)/documents/drops/$(dropId)).data.callParticipantUids;
        }
        allow read: if isCallPresenceMember();
        allow create: if isCallPresenceMember() && request.auth.uid == uid;
        allow update: if isCallPresenceMember()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']);
        allow delete: if false;
      }
    }

    // Categories collection. ROUND 12: reads/creates/deletes by creator/member are gated off
    // while the workspace deletes; the workspace-OWNER delete branch is PRESERVED (the categories
    // stage runs client-side as the owner); the deleting owner keeps read (enumeration) via
    // isDeletingOwner. Personal categories (workspaceId == null) are unaffected (a missing
    // workspace is never "deleting"). A job-naming import create requires the OPEN fence.
    match /categories/{categoryId} {
      allow read: if request.auth != null && (
        (request.auth.uid == resource.data.createdBy
          && !wsDeleting(resource.data.workspaceId))
        || (resource.data.workspaceId != null
          && !wsDeleting(resource.data.workspaceId)
          && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.members)
        || isDeletingOwner(resource.data.workspaceId)
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && !wsDeleting(request.resource.data.workspaceId)
        && (request.resource.data.workspaceId == null
            || request.auth.uid in get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.members)
        && importEpochAdmitted();
      allow delete: if request.auth != null && (
        (request.auth.uid == resource.data.createdBy
          && !wsDeleting(resource.data.workspaceId))
        || (resource.data.workspaceId != null
          && exists(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId))
          && get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.ownerId == request.auth.uid)
      );
    }

    // Chat conversations - users can only access their own
    match /chats/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /conversations/{convId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;

        match /messages/{msgId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if request.auth != null && request.auth.uid == userId;
          allow delete: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Agent usage counters (per-user quota) — written ONLY by the backend Admin SDK,
    // keyed on the Firebase-verified uid (the Admin SDK bypasses firestore.rules). Clients
    // never read or write this doc; deny all as defense-in-depth.
    match /usage/{uid} {
      allow read, write: if false;
    }

    // ---- ROUND 12 NEW COLLECTIONS ----

    // Deletion notices (tombstones) — created ONLY by the Admin PREPARE route
    // (/api/workspaces/delete-prepare-notices). Doc id: {recipientId}_{workspaceId}.
    // The recipient reads their own notice (drives the goodbye toast) and deletes it
    // (cooperative acknowledgment). No client create/update — a member can neither
    // forge nor silence another member's notice.
    match /deletionNotices/{noticeId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.recipientId;
      allow create, update: if false;
    }

    // Deletion receipts — written ONLY by the Admin SEAL route
    // (/api/workspaces/delete-finalize) atomically with the parent delete. Read by the
    // deleted workspace's owner OR any frozen recipient holding a notice (both use it
    // as the completion authority when the workspace doc is gone).
    match /deletionReceipts/{workspaceId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
          || request.auth.uid in resource.data.recipients);
      allow write: if false;
    }

    // Call termination/attempt records — server-only accounting + obligation ledger for
    // the call terminal primitive. Doc id: {callDropId}_{attemptKey}. Clients never
    // read or write these.
    match /callTerminations/{attemptId} {
      allow read, write: if false;
    }

    // Account barriers — the account-deletion finalizer state, written ONLY by the
    // /api/account/barrier-* Admin routes. The owner may READ their own barrier
    // (progress/resume UX); everything else is denied. Other rules reach it via get()
    // in barrierBlocks() — a fail-closed predicate, never reconciliation.
    match /accountBarriers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Import fences — the durable import producer state, written ONLY by the
    // /api/archive/import-fence Admin route. The fence owner (own userId) may read the
    // fence, its item ledger, and its manifest chunks; nobody else.
    match /importFences/{fenceId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/importFences/$(fenceId))
        && request.auth.uid == get(/databases/$(database)/documents/importFences/$(fenceId)).data.userId;
      allow write: if false;

      match /items/{itemId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/importFences/$(fenceId))
          && request.auth.uid == get(/databases/$(database)/documents/importFences/$(fenceId)).data.userId;
        allow write: if false;
      }

      match /manifest/{chunkId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/importFences/$(fenceId))
          && request.auth.uid == get(/databases/$(database)/documents/importFences/$(fenceId)).data.userId;
        allow write: if false;
      }
    }

    // Deletion job certificates — the notice-preparation certificate + seal state,
    // written ONLY by the Admin PREPARE/SEAL routes. Clients get it all via
    // /api/workspaces/delete-status (Admin); no direct client access.
    match /deletionJobs/{workspaceId} {
      allow read, write: if false;
    }
  }
}
